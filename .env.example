# DocuMind AI - Environment Configuration Example

# Backend Settings
PROJECT_NAME="DocuMind AI"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration (PostgreSQL in production, SQLite fallback locally)
# Local SQLite default:
DATABASE_URL="sqlite+aiosqlite:///./documind.db"
# Managed PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://user:password@hostname:5432/documind"

# JWT Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Storage Paths
STORAGE_DIR="./storage/pdfs"
CHROMA_PERSIST_DIR="./storage/chroma"

# AI / ML Retrieval Models
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
CROSS_ENCODER_MODEL_NAME="cross-encoder/ms-marco-MiniLM-L-6-v2"
ENABLE_CROSS_ENCODER=false

# LLM Provider Configuration ('gemini', 'openai', 'local', or 'auto')
LLM_PROVIDER="auto"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Frontend Settings (Next.js)
NEXT_PUBLIC_API_URL="http://localhost:8000"
